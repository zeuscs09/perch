<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key>
  <string>com.perch.daemon</string>
  <key>CFBundleName</key>
  <string>Perch</string>
  <key>CFBundleDisplayName</key>
  <string>Perch</string>
  <key>CFBundleExecutable</key>
  <string>perch</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleIconFile</key>
  <string>AppIcon</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleShortVersionString</key>
  <string>0.1</string>
  <key>CFBundleVersion</key>
  <string>1</string>
  <!-- ไม่มีไอคอนใน Dock — ตัวนี้เป็น daemon เบื้องหลัง (เมนูบาร์จะมาทีหลัง) -->
  <key>LSUIElement</key>
  <true/>
  <key>LSMinimumSystemVersion</key>
  <string>14.0</string>
  <!-- ขาดคีย์นี้แล้ว TCC ไม่ได้ปฏิเสธเฉยๆ แต่ยิง SIGABRT ใส่ทั้งโปรเซส -->
  <key>NSBluetoothAlwaysUsageDescription</key>
  <string>Perch talks to the desk display over Bluetooth LE.</string>
  <!-- ทางสำรองเมื่อ BLE ไกลเกิน: หาบอร์ดบน LAN แล้วส่ง snapshot ไปทาง TCP
       macOS 15 ขึ้นไปขออนุญาต Local Network แยกจาก Bluetooth และการขาดคีย์นี้
       ทำให้ทั้ง Bonjour และการต่อไปหา IP ตรงๆ เงียบไปเฉยๆ ไม่มี error ให้เห็น -->
  <key>NSLocalNetworkUsageDescription</key>
  <string>Perch sends the display update to the desk board over your local network when Bluetooth is out of range.</string>
  <key>NSBonjourServices</key>
  <array>
    <string>_perch._tcp</string>
  </array>
</dict>
</plist>
